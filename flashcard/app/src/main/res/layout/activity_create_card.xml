<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


<LinearLayout
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".method.CreateCardActivity">

    <include
        layout="@layout/toolbar_main"
        android:id="@+id/toolbar_create_card" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/front" />

    <EditText
        android:id="@+id/front_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"/>

<!--    <ImageView-->
<!--        android:id="@+id/imageFrontView"-->
<!--        android:layout_width="200dp"-->
<!--        android:layout_height="200dp"-->
<!--        android:scaleType="centerCrop"/>-->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/frontImage" />

    <Button
        android:id="@+id/btnImageFrontUpload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/selectImage" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/frontSound" />

    <Button
        android:id="@+id/btnSoundFrontUpload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/selectSound"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/back" />

    <EditText
        android:id="@+id/back_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/backImage" />

    <Button
        android:id="@+id/btnImageBackUpload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/selectImage"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/backSound" />

    <Button
        android:id="@+id/btnSoundBackUpload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/selectImage"/>

</LinearLayout>
</ScrollView>